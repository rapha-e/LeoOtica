# =============================================================================
# Nova Lab / OptiMind — Variaveis de Ambiente do Backend
# =============================================================================
# Copie este arquivo para .env e preencha os valores:
#   cp .env.example .env
# NUNCA envie o .env para o repositorio Git!
# =============================================================================

# --- Ambiente ---
# development -> ativa logs SQL e modo debug
# production  -> silencia logs, ativa restricoes de seguranca
APP_ENV=development

# --- Banco de Dados ---
# PostgreSQL (producao recomendada):
DATABASE_URL=postgresql+asyncpg://leouser:leopassword@localhost:5432/Nova Lab
# SQLite (desenvolvimento local - nao requer Docker):
# DATABASE_URL=sqlite+aiosqlite:///./Nova Lab.db

# --- Seguranca JWT ---
# OBRIGATORIO em producao. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_SECRETA_FORTE_DE_64_CARACTERES

# Duracao do token de acesso em minutos (padrao: 360 = 6 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=360

# --- CORS ---
# Origens permitidas separadas por virgula.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- IA / Google Gemini ---
# Obtenha em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- PostgreSQL (se usar Docker) ---
POSTGRES_USER=leouser
POSTGRES_PASSWORD=leopassword
POSTGRES_DB=Nova Lab

# --- Focus NFe (Integração Fiscal SEFAZ) ---
# Tokens obtidos no painel da Focus NFe (homologacao.focusnfe.com.br ou focusnfe.com.br)
# Deixe vazio para operar em Modo Simulação Local
FOCUS_NFE_TOKEN=
FOCUS_NFE_TOKEN_HOMOLOGACAO=
FOCUS_NFE_TOKEN_PRODUCAO=
# Ambiente: 'homologacao' para testes sem valor fiscal, ou 'producao' para notas reais
FOCUS_NFE_ENV=homologacao
# CNPJ do emitente cadastrado na Focus NFe
FOCUS_NFE_CNPJ_EMITENTE=

